# ============================================================
# AcadeConnect - Frontend environment
# Copy to .env.local and adjust if your backend is not proxied.
# By default Vite proxies /api and /uploads to http://localhost:5000
# ============================================================

# Leave empty to use the Vite proxy (default for local dev).
VITE_API_URL=
# Example when deploying separately:
# VITE_API_URL=https://your-backend.com/api
