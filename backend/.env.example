# ============================================================
# AcadeConnect - Backend environment
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:5173

# Fuso de referência dos eventos/atividades (horários de parede).
# O fim da atividade para presença é calculado neste fuso, não no do servidor.
EVENT_TIMEZONE=America/Sao_Paulo

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/academica

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=acadeconnect_token

# Rate limiting (V9.2 - NAT safe)
# The general API limit is keyed PER SESSION (hash of the bearer/cookie token),
# so hundreds of users behind the same campus NAT do not share a budget.
# It falls back to the IP for anonymous requests.
RATE_LIMIT_WINDOW_MS=60000
# Authenticated / token-bearing requests (per session bucket).
RATE_LIMIT_MAX=600
# Anonymous requests fall back to an IP bucket. The whole campus may share one
# public IP, so this ceiling is deliberately higher than the per-session one.
RATE_LIMIT_ANON_MAX=3000
# Failed login attempts allowed per (IP + e-mail) in 15 minutes.
# Successful logins are NOT counted, so a whole class can sign in at once.
AUTH_RATE_LIMIT_MAX=10
# Coarse per-IP ceiling for /auth/login and /auth/register (login peak absorption).
AUTH_PEAK_LIMIT_MAX=600
# Limit for expensive endpoints (exports, certificate issuance, orders, PIX), per user.
HEAVY_RATE_LIMIT_MAX=60
# Limit for opening realtime (SSE) streams, per user/session.
STREAM_RATE_LIMIT_MAX=20

# Database connection pool (Prisma).
# connection_limit: max simultaneous connections THIS process opens.
# Do NOT raise blindly — measure first. For a single Render instance a small
# pool (10) is usually far better than a large one.
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10
PRISMA_CONNECT_TIMEOUT=10
# Abort a socket that stops responding, so a stuck connection is recycled.
PRISMA_SOCKET_TIMEOUT=30
# Set to true to log slow Prisma queries (never enable verbose logging in prod).
PRISMA_LOG_QUERIES=false
PRISMA_SLOW_QUERY_MS=100

# PostgreSQL connection budget (IMPORTANT for 500 users)
# Total connections the DB must accept =
#   (number of backend instances) x PRISMA_CONNECTION_LIMIT
#   + migrations/psql + safety margin.
# Render's managed PostgreSQL plan defines the hard max_connections. Keep the
# sum comfortably below it. Do NOT set connection_limit=500.

# Password hashing (V9.2)
# bcrypt cost. Keep 12 in production - never lower it just to win a benchmark.
BCRYPT_ROUNDS=12
# Worker threads used for bcrypt so hashing does not block the HTTP event loop.
# 0 disables the pool (in-process fallback). Default: CPUs-1, capped at 4.
PASSWORD_HASH_WORKERS=2

# In-memory cache TTLs (ms) for read-heavy, low-write data.
PUBLIC_CACHE_TTL_MS=15000
DASHBOARD_CACHE_TTL_MS=30000
# Short TTL for the authenticated user lookup done on every request.
AUTH_USER_CACHE_MS=5000
# Hard cap on cached entries (LRU-ish eviction) so the heap cannot grow forever.
CACHE_MAX_ENTRIES=1000

# Observability
# GET /api/metrics returns aggregate metrics (no user data).
# When METRICS_TOKEN is empty the endpoint is only served outside production.
METRICS_TOKEN=
# Log requests slower than this (ms).
SLOW_REQUEST_LOG_MS=1000

# Load test (backend/scripts/load-test.mjs)
LOAD_TEST_BASE_URL=http://localhost:5000/api
LOAD_TEST_EMAIL=demo@example.com
LOAD_TEST_PASSWORD=change-me
LOAD_TEST_USERS=25

# HTTP compression (gzip) for JSON/text responses.
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD=1024

# Node HTTP keep-alive (behind Render's proxy).
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Email (SMTP) - optional. Set EMAIL_ENABLED=true and fill credentials to enable.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=AcadeConnect <no-reply@acadeconnect.local>

# Demo seed credentials
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_PARTICIPANT_EMAIL=participante@demo.com
DEMO_PARTICIPANT_PASSWORD=Participante@12345
