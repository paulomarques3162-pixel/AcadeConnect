// AcadeConnect - Prisma schema
// Provider: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  OPEN
  ONGOING
  CLOSED
  CANCELLED
}

enum Modality {
  PRESENCIAL
  ONLINE
  HIBRIDO
}

enum ActivityType {
  PALESTRA
  MINICURSO
  WORKSHOP
  MESA_REDONDA
  CURSO
  OFICINA
  NETWORKING
  PRATICA
  OUTRO
}

enum ActivityStatus {
  SCHEDULED
  OPEN
  FULL
  ONGOING
  FINISHED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PENDING
}

enum AttendanceMethod {
  QR_CODE
  MANUAL
  IMPORTACAO
  ADMIN
}

enum CertificateStatus {
  PENDING
  AVAILABLE
  ISSUED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  REGISTRATION
  ATTENDANCE
  CERTIFICATE
  EVENT
  REMINDER
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CouponType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum RaffleStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

// ============================================================
// MODELS
// ============================================================

model Institution {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?  @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  events  Event[]
  speakers Speaker[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(PARTICIPANT)
  phone          String?
  course         String?
  city           String?
  state          String?
  avatarUrl      String?
  emailVerified  Boolean  @default(false)
  institutionId  String?
  deletedAt      DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution         Institution?     @relation(fields: [institutionId], references: [id])
  registrations       Registration[]
  attendancesRecorded Attendance[]      @relation("AttendanceOperator")
  attendances         Attendance[]      @relation("Attendee")
  certificates        Certificate[]
  notifications       Notification[]
  audits              AuditLog[]
  organizedEvents     Event[]           @relation("EventOrganizer")
  correctedCertificates Certificate[]   @relation("CertificateCorrector")
  payments            Payment[]         @relation("PaymentUser")
  paymentsConfirmed   Payment[]         @relation("PaymentConfirmer")
  orders              Order[]
  conversations       Conversation[]    @relation("ConversationUser")
  assignedConversations Conversation[]  @relation("ConversationAssignee")
  messagesSent        Message[]         @relation("MessageSender")
  rafflesCreated      Raffle[]          @relation("RaffleCreator")
  raffleWins          RaffleWinner[]    @relation("RaffleWinnerUser")
  rafflesDrawn        RaffleWinner[]    @relation("RaffleDrawer")

  @@index([email])
  @@index([role])
@@index([createdAt])
}

model Event {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  shortDescription String?
  description      String?
  bannerUrl        String?
  startDate        DateTime
  endDate          DateTime
  startTime        String?
  location         String?
  address          String?
  modality         Modality    @default(PRESENCIAL)
  category         String?
  capacity         Int?
  registrationStart DateTime?   @default(now())
  registrationEnd  DateTime?
  status           EventStatus @default(DRAFT)
  allowRegistration Boolean    @default(true)
  allowCancellation Boolean    @default(true)
  requireActivityRegistration Boolean @default(false)
  requireAttendance Boolean    @default(true)
  automaticCertificate Boolean @default(false)
  minimumAttendancePercentage Float  @default(75)
  certificateHours Float        @default(8)
  isPaid           Boolean    @default(false)
  priceCents       Int?
  minPriceCents    Int?
  maxPriceCents    Int?
  institutionId    String?
  organizerId      String?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  organizer   User?        @relation("EventOrganizer", fields: [organizerId], references: [id])
  activities  Activity[]
  registrations Registration[]
  attendance  Attendance[]
  certificates Certificate[]
  payments    Payment[]
  raffles     Raffle[]
  raffleWinners RaffleWinner[]

  @@index([status])
  @@index([slug])
@@index([deletedAt, status])
@@index([deletedAt, createdAt])
@@index([startDate])
}

model Speaker {
  id          String   @id @default(cuid())
  name        String
  email       String?
  specialty   String?
  bio         String?
  photoUrl    String?
  institutionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  activities  Activity[]

  @@index([name])
}

model Activity {
  id              String       @id @default(cuid())
  eventId         String
  name            String
  slug            String?
  description     String?
  type            ActivityType @default(OUTRO)
  date            DateTime
  startTime       String
  endTime         String
  location        String?
  capacity        Int?
  speakerId       String?
  imageUrl        String?
  status          ActivityStatus @default(SCHEDULED)
  allowsRegistration Boolean   @default(true)
  requiresAttendance Boolean   @default(true)
  generatesCertificate Boolean @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker    Speaker? @relation(fields: [speakerId], references: [id])
  registrations ActivityRegistration[]
  attendance Attendance[]
  certificates Certificate[]

  @@index([eventId])
  @@index([date])
@@index([eventId, date])
}

model Registration {
  id          String             @id @default(cuid())
  code        String             @unique
  qrToken     String             @unique
  userId      String
  eventId     String
  status      RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime          @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User   @relation(fields: [userId], references: [id])
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activityRegistrations ActivityRegistration[]
  attendance Attendance[]
  certificates Certificate[]
  qrActive    Boolean          @default(true)
  payment     Payment?
  raffleWins  RaffleWinner[]

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
@@index([eventId, status])
@@index([createdAt])
@@index([eventId, createdAt])
}

model ActivityRegistration {
  id             String   @id @default(cuid())
  registrationId String
  activityId     String
  status         RegistrationStatus @default(CONFIRMED)
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([registrationId, activityId])
@@index([activityId, status])
}

model Attendance {
  id             String           @id @default(cuid())
  registrationId String
  activityId     String
  userId         String
  eventId        String
  status         AttendanceStatus @default(PRESENT)
  method         AttendanceMethod @default(QR_CODE)
  recordedAt     DateTime         @default(now())
  operatorId     String?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user         User         @relation("Attendee", fields: [userId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  operator     User?        @relation("AttendanceOperator", fields: [operatorId], references: [id])

  @@unique([registrationId, activityId])
  @@index([activityId])
  @@index([userId])
@@index([eventId])
@@index([eventId, recordedAt])
}

model Certificate {
  id             String            @id @default(cuid())
  code           String            @unique
  userId         String
  eventId        String
  registrationId String
  activityId     String?
  hours          Float
  issueDate      DateTime          @default(now())
  pdfUrl         String?
  status         CertificateStatus @default(AVAILABLE)
  createdAt      DateTime          @default(now())

  // Correção administrativa (erro de digitação) — preserva histórico/rastreabilidade.
  invalidatedAt    DateTime?
  correctionOfId   String?
  correctionReason String?
  correctedById    String?
  correctedAt      DateTime?
  // Overrides de dados corrigidos (usados no PDF quando presentes).
  participantName  String?
  eventName        String?

  user         User      @relation(fields: [userId], references: [id])
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  activity     Activity? @relation(fields: [activityId], references: [id])
  correctedBy     User?         @relation("CertificateCorrector", fields: [correctedById], references: [id])
  correctionOf    Certificate?  @relation("CertificateCorrection", fields: [correctionOfId], references: [id])
  corrections     Certificate[] @relation("CertificateCorrection")

  // Várias versões (original + correções) podem coexistir para o mesmo usuário/evento.
  @@index([userId, eventId, activityId])
  @@index([code])
@@index([eventId])
@@index([userId, issueDate])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
@@index([userId, read])
@@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
@@index([userId])
}

// ============================================================
// PAGAMENTOS / PIX
// ============================================================

model PixConfig {
  id           String   @id @default(cuid())
  key          String
  keyType      String   @default("EVP")
  receiverName String
  city         String
  description  String?
  active       Boolean  @default(true)
  // Tempo de disponibilidade do PIX (minutos). Máximo 120 (2h), aplicado no service.
  expiresMinutes Int    @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]

  @@index([active])
}

model Payment {
  id             String        @id @default(cuid())
  code           String        @unique
  userId         String
  eventId        String?
  registrationId String?       @unique
  orderId        String?       @unique
  amountCents    Int
  method         String        @default("PIX")
  status         PaymentStatus @default(PENDING)
  pixConfigId    String?
  pixPayload     String?       @db.Text
  txid           String?       @unique
  paidAt         DateTime?
  confirmedById  String?
  notes          String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation("PaymentUser", fields: [userId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pixConfig    PixConfig?    @relation(fields: [pixConfigId], references: [id], onDelete: SetNull)
  confirmedBy  User?         @relation("PaymentConfirmer", fields: [confirmedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([eventId])
@@index([status, expiresAt])
@@index([createdAt])
@@index([userId, createdAt])
}

// ============================================================
// PRODUTOS / CUPONS / PEDIDOS
// ============================================================

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)
  featured    Boolean       @default(false)
  stock       Int?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems OrderItem[]

  @@index([status])
@@index([status, deletedAt])
@@index([status, featured])
}

model Coupon {
  id                 String     @id @default(cuid())
  code               String     @unique
  type               CouponType
  value              Int
  validFrom          DateTime?
  validUntil         DateTime?
  maxUses            Int?
  usedCount          Int        @default(0)
  minOrderValueCents Int?
  active             Boolean    @default(true)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  orders Order[]

  @@index([code])
  @@index([active])
@@index([active, deletedAt])
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  userId        String
  subtotalCents Int
  discountCents Int         @default(0)
  totalCents    Int
  couponId      String?
  couponCode    String?
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  coupon  Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
@@index([createdAt])
@@index([userId, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  productName    String
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ============================================================
// COMUNICACAO
// ============================================================

model Conversation {
  id            String             @id @default(cuid())
  userId        String
  subject       String?
  status        ConversationStatus @default(OPEN)
  assignedToId  String?
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user       User      @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([userId])
  @@index([status])
@@index([lastMessageAt])
@@index([userId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  body           String   @db.Text
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
@@index([conversationId, createdAt])
@@index([conversationId, readAt])
}

// ============================================================
// SORTEIOS
// ============================================================

model Raffle {
  id            String       @id @default(cuid())
  eventId       String
  prize         String
  allowRepeat   Boolean      @default(false)
  status        RaffleStatus @default(OPEN)
  eligibleCount Int          @default(0)
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("RaffleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  winners   RaffleWinner[]

  @@index([eventId])
@@index([createdAt])
}

model RaffleWinner {
  id                  String   @id @default(cuid())
  raffleId            String
  eventId             String
  userId              String
  registrationId      String
  prizeSnapshot       String
  eligibleCountAtDraw Int
  drawnAt             DateTime @default(now())
  drawnById           String?

  raffle       Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User         @relation("RaffleWinnerUser", fields: [userId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  drawnBy      User?        @relation("RaffleDrawer", fields: [drawnById], references: [id], onDelete: SetNull)

  @@unique([raffleId, userId])
  @@index([eventId])
  @@index([userId])
}
