// AcadeConnect - Prisma schema
// Provider: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  OPEN
  ONGOING
  CLOSED
  CANCELLED
}

enum Modality {
  PRESENCIAL
  ONLINE
  HIBRIDO
}

enum ActivityType {
  PALESTRA
  MINICURSO
  WORKSHOP
  MESA_REDONDA
  CURSO
  OFICINA
  NETWORKING
  PRATICA
  OUTRO
}

enum ActivityStatus {
  SCHEDULED
  OPEN
  FULL
  ONGOING
  FINISHED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PENDING
}

enum AttendanceMethod {
  QR_CODE
  MANUAL
  IMPORTACAO
  ADMIN
}

enum CertificateStatus {
  PENDING
  AVAILABLE
  ISSUED
}

enum NotificationType {
  SYSTEM
  REGISTRATION
  ATTENDANCE
  CERTIFICATE
  EVENT
  REMINDER
}

// ============================================================
// MODELS
// ============================================================

model Institution {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?  @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  events  Event[]
  speakers Speaker[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(PARTICIPANT)
  phone          String?
  course         String?
  city           String?
  state          String?
  avatarUrl      String?
  emailVerified  Boolean  @default(false)
  institutionId  String?
  deletedAt      DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution         Institution?     @relation(fields: [institutionId], references: [id])
  registrations       Registration[]
  attendancesRecorded Attendance[]      @relation("AttendanceOperator")
  attendances         Attendance[]      @relation("Attendee")
  certificates        Certificate[]
  notifications       Notification[]
  audits              AuditLog[]
  organizedEvents     Event[]           @relation("EventOrganizer")

  @@index([email])
  @@index([role])
}

model Event {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  shortDescription String?
  description      String?
  bannerUrl        String?
  startDate        DateTime
  endDate          DateTime
  startTime        String?
  location         String?
  address          String?
  modality         Modality    @default(PRESENCIAL)
  category         String?
  capacity         Int?
  registrationStart DateTime?   @default(now())
  registrationEnd  DateTime?
  status           EventStatus @default(DRAFT)
  allowRegistration Boolean    @default(true)
  allowCancellation Boolean    @default(true)
  requireActivityRegistration Boolean @default(false)
  requireAttendance Boolean    @default(true)
  automaticCertificate Boolean @default(false)
  minimumAttendancePercentage Float  @default(75)
  certificateHours Float        @default(8)
  institutionId    String?
  organizerId      String?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  organizer   User?        @relation("EventOrganizer", fields: [organizerId], references: [id])
  activities  Activity[]
  registrations Registration[]
  attendance  Attendance[]
  certificates Certificate[]

  @@index([status])
  @@index([slug])
}

model Speaker {
  id          String   @id @default(cuid())
  name        String
  email       String?
  specialty   String?
  bio         String?
  photoUrl    String?
  institutionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  activities  Activity[]

  @@index([name])
}

model Activity {
  id              String       @id @default(cuid())
  eventId         String
  name            String
  slug            String?
  description     String?
  type            ActivityType @default(OUTRO)
  date            DateTime
  startTime       String
  endTime         String
  location        String?
  capacity        Int?
  speakerId       String?
  imageUrl        String?
  status          ActivityStatus @default(SCHEDULED)
  allowsRegistration Boolean   @default(true)
  requiresAttendance Boolean   @default(true)
  generatesCertificate Boolean @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker    Speaker? @relation(fields: [speakerId], references: [id])
  registrations ActivityRegistration[]
  attendance Attendance[]
  certificates Certificate[]

  @@index([eventId])
  @@index([date])
}

model Registration {
  id          String             @id @default(cuid())
  code        String             @unique
  qrToken     String             @unique
  userId      String
  eventId     String
  status      RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime          @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User   @relation(fields: [userId], references: [id])
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activityRegistrations ActivityRegistration[]
  attendance Attendance[]
  certificates Certificate[]

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

model ActivityRegistration {
  id             String   @id @default(cuid())
  registrationId String
  activityId     String
  status         RegistrationStatus @default(CONFIRMED)
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([registrationId, activityId])
}

model Attendance {
  id             String           @id @default(cuid())
  registrationId String
  activityId     String
  userId         String
  eventId        String
  status         AttendanceStatus @default(PRESENT)
  method         AttendanceMethod @default(QR_CODE)
  recordedAt     DateTime         @default(now())
  operatorId     String?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user         User         @relation("Attendee", fields: [userId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  operator     User?        @relation("AttendanceOperator", fields: [operatorId], references: [id])

  @@unique([registrationId, activityId])
  @@index([activityId])
  @@index([userId])
}

model Certificate {
  id             String            @id @default(cuid())
  code           String            @unique
  userId         String
  eventId        String
  registrationId String
  activityId     String?
  hours          Float
  issueDate      DateTime          @default(now())
  pdfUrl         String?
  status         CertificateStatus @default(AVAILABLE)
  createdAt      DateTime          @default(now())

  user         User      @relation(fields: [userId], references: [id])
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  activity     Activity? @relation(fields: [activityId], references: [id])

  @@unique([userId, eventId, activityId])
  @@index([code])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
}
