+/**
+ * V9.4 — QR content test (no database required).
+ *
+ * Decodes the PNG generated by the backend and asserts the EXACT payload
+ * embedded in the QR:
+ *   - attendance QR encodes the opaque attendance token;
+ *   - PIX QR encodes the EMV "copia e cola" payload;
+ *   - the two are never confused (attendance token must NOT contain the EMV
+ *     marker, and the PIX payload must NOT be a raw token).
+ *
+ * This tests the part that breaks in production when QR and PIX get mixed up.
+ * The DB-dependent parts (matching the token to the right event/user, duplicate
+ * scan) are integration tests, listed as NOT EXECUTED in the report.
+ *
+ * Run: node scripts/test-qr-content.mjs
+ */
+import assert from 'node:assert/strict';
+import JSQR from 'jsqr';
+import { PNG } from 'pngjs';
+
+import { generateQrDataUrl } from '../src/utils/qr.js';
+import { buildPixPayload, crc16 } from '../src/utils/pix.js';
+
+let pass = 0;
+let fail = 0;
+function check(name, fn) {
+  try {
+    fn();
+    pass += 1;
+    console.log(`PASS  ${name}`);
+  } catch (err) {
+    fail += 1;
+    console.log(`FAIL  ${name}\n      ${err.message}`);
+  }
+}
+
+/** Decode the first frame of a data:image/png;base64,... URL. */
+function decodeDataUrl(dataUrl) {
+  const base64 = dataUrl.split(',')[1];
+  const png = PNG.sync.read(Buffer.from(base64, 'base64'));
+  const result = JSQR(new Uint8ClampedArray(png.data), png.width, png.height);
+  assert.ok(result, 'QR could not be decoded');
+  return result.data;
+}
+
+const dataUrl = await generateQrDataUrl('att_test');
+
+check('attendance QR is a valid PNG data URL', () => {
+  assert.ok(dataUrl.startsWith('data:image/png;base64,'));
+});
+
+check('attendance QR decodes to the exact opaque token (no prefix, no mutation)', () => {
+  assert.ok(dataUrl.length > 100);
+  const decoded = decodeDataUrl(dataUrl);
+  assert.equal(decoded, 'att_test');
+});
+
+check('attendance QR round-trips a realistic token byte-for-byte', async () => {
+  const token = 'qr_9d2f4c1a8e7b3f60a5c4e2d1b0a9f8e7d6c5b4a3';
+  const url = generateQrDataUrl(token);
+  const decoded = decodeDataUrl(await url);
+  assert.equal(decoded, token);
+});
+
+check('PIX QR encodes the full EMV payload (QR == copia e cola)', async () => {
+  const payload = buildPixPayload({
+    key: 'mustangs@atletica.com',
+    receiverName: 'Mustangs Atletica',
+    city: 'SAO PAULO',
+    amountCents: 5000,
+    txid: 'EVENTO123',
+  });
+  const url = await generateQrDataUrl(payload);
+  const decoded = decodeDataUrl(url);
+  assert.equal(decoded, payload, 'QR content must equal the PIX copia-e-cola payload');
+});
+
+check('PIX payload carries a valid CRC and the configured amount', () => {
+  const payload = buildPixPayload({
+    key: 'mustangs@atletica.com',
+    receiverName: 'Mustangs Atletica',
+    city: 'SAO PAULO',
+    amountCents: 5000,
+    txid: 'EVENTO123',
+  });
+  assert.ok(payload.includes('5303986'), 'currency must be BRL (986)');
+  assert.ok(payload.includes('540550.00'), 'amount 5000 cents must encode as 50.00');
+  assert.ok(payload.includes('br.gov.bcb.pix'), 'PIX GUI must be present');
+  const withoutCrc = payload.slice(0, -4);
+  assert.equal(crc16(withoutCrc), payload.slice(-4), 'CRC must validate');
+});
+
+check('attendance QR and PIX QR are not confusable', async () => {
+  const token = 'qr_opaque_token_123';
+  const pix = buildPixPayload({
+    key: 'mustangs@atletica.com',
+    receiverName: 'Mustangs Atletica',
+    city: 'SAO PAULO',
+    amountCents: 100,
+    txid: 'X1',
+  });
+  const decodedToken = decodeDataUrl(await generateQrDataUrl(token));
+  const decodedPix = decodeDataUrl(await generateQrDataUrl(pix));
+
+  assert.ok(!decodedToken.includes('br.gov.bcb.pix'), 'attendance QR must not look like PIX');
+  assert.ok(!decodedPix.startsWith('qr_') && !decodedPix.startsWith('att_'), 'PIX QR must not be a raw token');
+  assert.notEqual(decodedToken, decodedPix);
+});
+
+console.log(`\nTOTAL: ${pass} PASS / ${fail} FAIL\n`);
+process.exit(fail === 0 ? 0 : 1);
